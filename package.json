{
  "name": "line-mcp-app",
  "version": "0.1.0",
  "description": "LINE \u6b21\u8981\u88dd\u7f6e\u540c\u6b65 + \u672c\u6a5f MCP\uff08Android App \u6838\u5fc3\uff09",
  "scripts": {
    "test": "node --test test/*.test.ts",
    "login:qr": "node scripts/login-poc.ts",
    "serve:fake": "node scripts/serve-fake.ts",
    "typecheck": "tsc --noEmit",
    "bundle:android": "bun scripts/bundle.ts",
    "android:debug": "npm run bundle:android && cd android && ./gradlew assembleDebug",
    "start": "node src/main.ts",
    "bundle:android:release": "bun scripts/bundle.ts --release && bash scripts/purge-mock-check.sh android/app/src/main/assets/nodeapp/main.mjs"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@evex-dev/linejs": "^3.6.9",
    "@evex-dev/linejs-types": "^3.6.9",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.6.7"
  },
  "private": true,
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^7.0.2"
  }
}
